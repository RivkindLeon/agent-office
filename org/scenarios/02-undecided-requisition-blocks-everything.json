      {
        "role": "head-of-engineering",
        "decision": "pending",
        "hiring_manager": "founder",
        "reports_to": "ceo"
      }
    ],
    "roles": [
      {
        "role": "head-of-people",
        "from": "head-of-people"
      }
    ],
    "journal": [
      {
        "type": "hired",
        "subject": "head-of-people"
      }
