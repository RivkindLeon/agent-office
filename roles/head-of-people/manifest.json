{
  "schema_version": 1,
  "role": "head-of-people",
  "version": "10.0",
  "reports_to": "ceo",
  "grade": "middle",
  "mode": "strict",
  "model": {
    "primary": "openai/gpt-5.6-luna",
    "fallbacks": [
      "openai/gpt-5.5"
    ]
  },
  "tools_profile": "coding",
  "budget_tokens": 100000,
  "triggers": [
    {
      "id": "write-package",
      "when": {
        "op": "role_state",
        "scope": "others",
        "state": "requisition_approved"
      },
      "work": "package"
    },
    {
      "id": "revise-package",
      "when": {
        "op": "role_state",
        "scope": "others",
        "state": "changes_requested",
        "max_round": 2
      },
      "work": "package"
    },
    {
      "id": "record-hire",
      "when": {
        "op": "role_state",
        "scope": "others",
        "state": "accepted"
      }
    }
  ],
  "work": [
    {
      "id": "package",
      "target_from": "trigger",
      "steps": [
        {
          "id": "boundaries",
          "artifact": "roles/{target}/BOUNDARIES.md"
        },
        {
          "id": "charter",
          "artifact": "roles/{target}/CHARTER.md"
        },
        {
          "id": "io",
          "artifact": "roles/{target}/IO.md"
        },
        {
          "id": "manifest",
          "artifact": "roles/{target}/manifest.json"
        },
        {
          "id": "comms",
          "artifact": "roles/{target}/COMMS.md"
        },
        {
          "id": "acceptance",
          "artifact": "roles/{target}/ACCEPTANCE.md"
        },
        {
          "id": "profile",
          "artifact": "roles/{target}/PROFILE.md"
        },
        {
          "id": "instructions",
          "artifact": "roles/{target}/INSTRUCTIONS.md"
        },
        {
          "id": "submit",
          "check": "package_complete"
        }
      ]
    }
  ]
}
