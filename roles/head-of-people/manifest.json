{
  "schema_version": 1,
  "role": "head-of-people",
  "version": "9.0",
  "reports_to": "ceo",
  "grade": "middle",
  "mode": "strict",
  "model": {
    "primary": "openai/gpt-5.6-luna",
    "fallbacks": [
      "openai/gpt-5.5"
    ]
  },
  "tools_profile": "coding",
  "budget_tokens": 100000,
  "triggers": [
    {
      "id": "write-package",
      "when": {
        "op": "role_state",
        "scope": "others",
        "state": "requisition_approved"
      }
    },
    {
      "id": "revise-package",
      "when": {
        "op": "role_state",
        "scope": "others",
        "state": "changes_requested",
        "max_round": 2
      }
    },
    {
      "id": "record-hire",
      "when": {
        "op": "role_state",
        "scope": "others",
        "state": "accepted"
      }
    }
  ]
}
